{
  "name": "merum-fe",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build merum-fe --configuration production --output-path=dist/merum-fe",
    "build:prod": "ng build merum-fe --configuration production --output-path=dist/merum-fe",
    "watch": "ng build merum-fe --watch --configuration development",
    "test": "ng test --browsers=FirefoxHeadless --no-watch",
    "test:firefox": "ng test --browsers=FirefoxHeadless --no-watch",
    "test:firefox:headed": "ng test --browsers=Firefox",
    "test:edge": "ng test --browsers=EdgeHeadless --no-watch",
    "test:edge:headed": "ng test --browsers=Edge",
    "test:chrome": "ng test --browsers=ChromeHeadless --no-watch",
    "test:chrome:headed": "ng test --browsers=Chrome",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/ssr": "^22.2.5",
    "express": "^4.18.2",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.0",
    "ssl-root-cas": "^1.3.1",
    "swiper": "^12.0.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.6.6",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-edge-launcher": "^0.4.2",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
